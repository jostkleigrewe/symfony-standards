# shellcheck shell=bash disable=SC2034  # sourced by deploy/post-deploy.sh
# Settings for deploy/post-deploy.sh — versioned, NO secrets (those belong in .env.local on the server).
# Sourced by bash; uncomment what the server needs.

# Plesk with phpenv: the deploy action runs without a login shell, so PHP comes from the subscription's shims.
# export HOME="/var/www/vhosts/<subscription>"
# export PATH="$HOME/.phpenv/shims:$PATH"
# PHP_BIN="$HOME/.phpenv/shims/php"

# PHP_MEMORY_LIMIT="512M"

# Messenger workers under supervisor (needs a sudoers rule for the subscription user, e.g. arma-ai deploy/sudoers.conf).
# Without WORKER_STOP_CMD the script only sends messenger:stop-workers after the migrations.
# WORKER_STOP_CMD="sudo -n /usr/bin/supervisorctl stop 'myapp:*'"
# WORKER_START_CMD="sudo -n /usr/bin/supervisorctl restart 'myapp:*'"

# Reload PHP-FPM after the deploy so the OPcache drops the old code (needs a sudoers rule as well).
# FPM_RELOAD_CMD="sudo -n /usr/bin/systemctl reload plesk-php85-fpm"

# The hosting action appends the output to this file; the script keeps the last lines.
# DEPLOY_LOG="var/log/deploy.log"
# DEPLOY_LOG_KEEP_LINES=5000

# Variables .env.local must define (the deploy stops when one is missing).
REQUIRED_VARS=(APP_SECRET DATABASE_URL)

# Per-server values (health URL, secrets) belong in .env.local: DEPLOY_HEALTH_URL=https://…
