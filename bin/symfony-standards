#!/usr/bin/env bash
# DE: Ein Befehl für lokale Prüfung und CI — die CI ruft genau diesen Befehl auf, damit „lokal grün“ = „CI grün“.
# EN: One entry point for local checks and CI; the reusable workflow calls exactly this command.
set -uo pipefail

PKG_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
readonly PKG_DIR
readonly SKIPPED=99
# DE: Schritt hat nur gewarnt (zählt im strengen Modus als Fehler).
# EN: Step only warned (counts as a failure in strict mode).
readonly WARNED=98
readonly STEPS=(app-secret composer-validate composer-audit importmap-install cs-fixer cache-warmup phpstan rector lint-container lint-yaml lint-twig doctrine-schema importmap-audit phpunit)

usage() {
    cat <<EOF
Usage: vendor/bin/symfony-standards <command> [args]

  check [--strict] [step...]
                    Run all checks (or only the given steps) — same as CI.
                    --strict (or SYMFONY_STANDARDS_STRICT=1) turns warnings into failures.
  fix               Apply php-cs-fixer and rector changes
  init              Copy missing templates into the project (never overwrites)
  steps             List the check steps

Run from the project root. Steps: ${STEPS[*]}
EOF
}

in_ci() { [[ "${GITHUB_ACTIONS:-}" == "true" ]]; }
group_start() { if in_ci; then echo "::group::$1"; else printf '\n\033[1;34m▶ %s\033[0m\n' "$1"; fi; }
group_end() { if in_ci; then echo "::endgroup::"; fi; }
# DE: Liefert 0, wenn eine APP_SECRET-Zeile in .env einen Wert hat. Den Wert nie ausgeben.
#     .env ist versioniert; das Geheimnis gehört in .env.local auf dem Server. .env.dev/.env.test/.env.local* bleiben außen vor.
# EN: Returns 0 when an APP_SECRET line in .env has a value. Never print the value.
#     .env is committed; the secret belongs in .env.local on the server. .env.dev/.env.test/.env.local* are not checked.
check_app_secret() {
    local line rest value nr=0 found=1
    local re_line='^[[:space:]]*(export[[:space:]]+)?APP_SECRET[[:space:]]*=(.*)$' re_dq='^"([^"]*)"' re_sq="^'([^']*)'"
    while IFS= read -r line || [[ -n $line ]]; do
        nr=$((nr + 1))
        [[ $line =~ $re_line ]] || continue
        rest=${BASH_REMATCH[2]}
        rest=${rest#"${rest%%[![:space:]]*}"}
        if [[ $rest =~ $re_dq || $rest =~ $re_sq ]]; then
            value=${BASH_REMATCH[1]}
        elif [[ $rest == \#* ]]; then
            value=
        else
            # DE: Ohne Anführungszeichen endet der Wert vor dem ersten „ #“. EN: Unquoted value ends before the first " #".
            value=${rest%%[[:space:]]#*}
            value=${value%"${value##*[![:space:]]}"}
        fi
        # DE: Jede Zeile zählt — auch ein später überschriebener Wert steht im Git. EN: Every line counts; an overridden value is still in Git.
        if [[ -n $value ]]; then
            echo "⚠️  .env:$nr: APP_SECRET has a value — leave it empty, the value belongs in .env.local on the server (set the server first, then empty .env) [app-secret-in-env]"
            in_ci && echo "::warning file=.env,line=$nr,title=symfony-standards::APP_SECRET has a value in .env (app-secret-in-env)"
            found=0
        fi
    done < .env
    return $found
}

console_has() { php bin/console list --raw 2>/dev/null | awk '{print $1}' | grep -x "$1" >/dev/null; }

# DE: Schritt ausführen. Rückgabe 0 = ok, SKIPPED = Voraussetzung fehlt im Projekt, sonst Fehler.
#     Nicht 2: Rector meldet gefundene Änderungen mit Exit 2.
# EN: Run one step. 0 ok, SKIPPED prerequisite missing, anything else fails (not 2: rector exits 2 on changes).
run_step() {
    case "$1" in
        app-secret)
            [[ -f .env ]] || return $SKIPPED
            if check_app_secret; then return $WARNED; fi
            echo "APP_SECRET in .env is empty"
            ;;
        composer-validate) composer validate --strict --no-check-publish ;;
        composer-audit) composer audit --locked --abandoned=report ;;
        importmap-install)
            # DE: assets/vendor/ ist nicht versioniert. Ohne den Download scheitern cache-warmup und Tests später mit
            #     unverständlichen Fehlern (Sandbox/CI ohne Netz) — darum früh holen und die Ursache klar benennen.
            # EN: assets/vendor/ is not versioned. Without the download cache-warmup and tests fail later with unclear
            #     errors (sandbox/CI without network), so fetch it early and name the cause.
            [[ -f importmap.php ]] && console_has importmap:install || return $SKIPPED
            php bin/console importmap:install && return 0
            echo "importmap:install failed — most likely no network or jsDelivr (cdn.jsdelivr.net) is unreachable." >&2
            echo "The packages from importmap.php are downloaded into assets/vendor/ (not versioned); without them" >&2
            echo "cache-warmup and tests fail. Allow cdn.jsdelivr.net (sandbox/CI firewall) or run it where the network works." >&2
            return 1
            ;;
        cs-fixer) PHP_CS_FIXER_IGNORE_ENV=1 vendor/bin/php-cs-fixer check --diff --show-progress=none ;;
        cache-warmup) php bin/console cache:warmup --env=dev ;;
        phpstan) vendor/bin/phpstan analyse --no-progress --memory-limit=1G ;;
        rector) vendor/bin/rector process --dry-run --no-progress-bar ;;
        lint-container) php bin/console lint:container ;;
        lint-yaml) php bin/console lint:yaml config --parse-tags ;;
        lint-twig)
            [[ -d templates ]] && console_has lint:twig || return $SKIPPED
            php bin/console lint:twig templates
            ;;
        doctrine-schema)
            console_has doctrine:schema:validate || return $SKIPPED
            # DE: --skip-sync: nur Mapping prüfen, die CI hat nicht immer eine Datenbank.
            # EN: mapping only; CI does not always have a database.
            php bin/console doctrine:schema:validate --skip-sync
            ;;
        importmap-audit)
            [[ -f importmap.php ]] || return $SKIPPED
            php bin/console importmap:audit
            ;;
        phpunit)
            [[ -d tests ]] || return $SKIPPED
            # Tests without a config would only print PHPUnit's usage text (backend, 2026-10-29) — say what is missing.
            if [[ ! -f phpunit.dist.xml && ! -f phpunit.xml.dist && ! -f phpunit.xml ]]; then
                echo "tests/ exists but no PHPUnit config (phpunit.dist.xml) — create one (Symfony recipe: composer recipes:install phpunit/phpunit --force)" >&2
                return 1
            fi
            local phpunit cfg suites
            if [[ -x bin/phpunit ]]; then phpunit=bin/phpunit; elif [[ -x vendor/bin/phpunit ]]; then phpunit=vendor/bin/phpunit; else return $SKIPPED; fi
            # A defaultTestSuite (e.g. "unit", standard symfony-testing-1.0) would make a bare run skip the
            # integration/application suites without anyone noticing — CI runs every suite by name (2026-11-12).
            for cfg in phpunit.xml phpunit.dist.xml phpunit.xml.dist; do [[ -f $cfg ]] && break; done
            if grep -q 'defaultTestSuite=' "$cfg"; then
                suites=$(grep -o '<testsuite name="[^"]*"' "$cfg" | sed 's/.*name="//; s/"$//' | paste -sd, -)
                [[ -n $suites ]] && { "$phpunit" --testsuite "$suites"; return; }
            fi
            "$phpunit"
            ;;
        *) echo "Unknown step: $1 (see: steps)" >&2; return 1 ;;
    esac
}

cmd_check() {
    local steps=() failed=() skipped=() warned=() step rc strict=0
    [[ "${SYMFONY_STANDARDS_STRICT:-0}" == "1" ]] && strict=1
    for step in "$@"; do
        if [[ $step == --strict ]]; then strict=1; else steps+=("$step"); fi
    done
    [[ ${#steps[@]} -eq 0 ]] && steps=("${STEPS[@]}")
    for step in "${steps[@]}"; do
        group_start "$step"
        run_step "$step"
        rc=$?
        group_end
        case $rc in
            0) ;;
            "$SKIPPED") skipped+=("$step") ;;
            "$WARNED")
                if [[ $strict -eq 1 ]]; then
                    failed+=("$step"); in_ci && echo "::error title=symfony-standards::step '$step' warned (strict mode)"
                else
                    warned+=("$step")
                fi
                ;;
            *) failed+=("$step"); in_ci && echo "::error title=symfony-standards::step '$step' failed" ;;
        esac
    done
    echo
    [[ ${#skipped[@]} -gt 0 ]] && echo "⏭  skipped (not used in this project): ${skipped[*]}"
    [[ ${#warned[@]} -gt 0 ]] && echo "⚠️  warnings: ${warned[*]} (--strict makes them fail)"
    if [[ ${#failed[@]} -gt 0 ]]; then
        echo "❌ failed: ${failed[*]}"
        return 1
    fi
    if [[ ${#warned[@]} -gt 0 ]]; then
        local noun=warnings
        [[ ${#warned[@]} -eq 1 ]] && noun=warning
        echo "✅ all checks passed (${#warned[@]} $noun)"
    else
        echo "✅ all checks passed"
    fi
}

cmd_fix() {
    PHP_CS_FIXER_IGNORE_ENV=1 vendor/bin/php-cs-fixer fix --show-progress=none
    vendor/bin/rector process --no-progress-bar
    # DE: Rector kann Stil-Abweichungen erzeugen — danach erneut formatieren.
    # EN: Rector may produce style drift, so format again.
    PHP_CS_FIXER_IGNORE_ENV=1 vendor/bin/php-cs-fixer fix --show-progress=none
}

cmd_init() {
    local src rel
    while IFS= read -r -d '' src; do
        rel="${src#"$PKG_DIR/templates/"}"
        if [[ -e "$rel" ]]; then
            # DE: Flex-Recipes (z. B. php-cs-fixer) legen eigene Configs an — die würden den Standard still ersetzen.
            # EN: Flex recipes create their own configs, which would silently replace the standard.
            if [[ "$rel" != deploy/* && "$rel" != .github/* ]] && ! grep -q symfony-standards "$rel"; then
                echo "⚠️  $rel exists and does not use the standard — compare: diff $rel $src"
            else
                echo "⏭  $rel exists — kept"
            fi
            continue
        fi
        mkdir -p "$(dirname "$rel")"
        cp -p "$src" "$rel"
        echo "✅ $rel created"
    done < <(find "$PKG_DIR/templates" -type f -print0 | sort -z)
    echo
    echo "Next: review the new files, set the PHP version in .github/workflows/ci.yml, run: vendor/bin/symfony-standards check"
}

main() {
    local cmd="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "$cmd" in
        check|fix|init)
            if [[ ! -f composer.json || ! -f bin/console ]]; then
                echo "Run from the root of a Symfony project (composer.json + bin/console)." >&2
                return 1
            fi
            "cmd_$cmd" "$@"
            ;;
        steps) printf '%s\n' "${STEPS[@]}" ;;
        -h|--help|help|"") usage ;;
        *) usage >&2; return 1 ;;
    esac
}

main "$@"
