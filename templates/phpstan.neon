# Standard: jostkleigrewe/symfony-standards. Raise the level here when the project is ready (6–8).
# Existing projects: create a baseline once with
#   vendor/bin/phpstan analyse --generate-baseline
# and add "- phpstan-baseline.neon" to the includes. New code must pass without new baseline entries.
includes:
    - vendor/jostkleigrewe/symfony-standards/config/phpstan.neon

parameters:
    paths:
        - src
        - tests
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    excludePaths:
        # Generated by the symfony/phpunit-bridge recipe (method_exists check is always true on current Symfony).
        - tests/bootstrap.php
