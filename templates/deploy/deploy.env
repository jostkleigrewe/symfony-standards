# shellcheck shell=bash disable=SC2034  # sourced by deploy/post-deploy.sh
# Settings for deploy/post-deploy.sh — versioned, NO secrets (those belong in .env.local on the server).
# Sourced by bash; uncomment what the server needs.

# Plesk with phpenv: the deploy action runs without a login shell, so PHP comes from the subscription's shims.
# export HOME="/var/www/vhosts/<subscription>"
# export PATH="$HOME/.phpenv/shims:$PATH"
# PHP_BIN="$HOME/.phpenv/shims/php"

# PHP_MEMORY_LIMIT="512M"

# Variables .env.local must define (the deploy stops when one is missing).
REQUIRED_VARS=(APP_SECRET DATABASE_URL)

# Per-server values (health URL, secrets) belong in .env.local: DEPLOY_HEALTH_URL=https://…
